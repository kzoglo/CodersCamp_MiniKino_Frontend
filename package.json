    "test": "react-scripts test --verbose --watchAll=false",
    "test-watch": "react-scripts test --verbose --watchAll",
    "test-unit": "npm test unit",
    "test-with-coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzoglo/CodersCamp_MiniKino_Frontend.git"
  },
  "bugs": {
