  },
  "license": "MIT",
  "engines": {
    "npm": "10.7.0",
    "node": "20.14.0"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^0.44.1",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
